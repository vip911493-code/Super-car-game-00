<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<title>Turbo Drift World</title>
<style>
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent;user-select:none}
  html,body{margin:0;height:100%;overflow:hidden;background:#000;font-family:'Segoe UI',system-ui,sans-serif;color:#fff}
  canvas{display:block}
  #hud{position:fixed;inset:0;pointer-events:none}
  .panel{background:rgba(15,25,40,.72);border:1px solid rgba(255,255,255,.12);border-radius:14px;padding:10px 14px;backdrop-filter:blur(4px)}
  #lap{position:absolute;left:14px;top:14px;font-size:15px;line-height:1.55;min-width:170px}
  #lap b{font-size:22px}
  #pos{position:absolute;left:14px;top:138px;font-size:15px;line-height:1.5;min-width:170px}
  #pos b{font-size:24px;color:#facc15}
  #pos span{color:#7dd3fc;font-weight:700}
  #mini{position:absolute;right:12px;top:12px;width:150px;height:150px;border-radius:14px}
  #btns{position:absolute;right:12px;top:170px;display:flex;gap:8px;pointer-events:auto}
  #btns button{background:rgba(15,25,40,.72);color:#fff;border:1px solid rgba(255,255,255,.2);border-radius:10px;font-size:18px;padding:6px 12px}
  #zone{position:absolute;left:50%;top:14px;transform:translateX(-50%);font-size:16px;font-weight:700;letter-spacing:1px;padding:6px 16px;opacity:0;transition:opacity .5s}
  #msg{position:absolute;left:50%;top:38%;transform:translate(-50%,-50%);font-size:64px;font-weight:900;font-style:italic;text-shadow:0 4px 24px #000;opacity:0;transition:opacity .25s;text-align:center;white-space:nowrap}
  #speedo{position:absolute;right:20px;bottom:20px;text-align:right;text-shadow:0 2px 12px #000}
  #speed{font-size:60px;font-weight:800;line-height:1;font-style:italic}
  #speed small{font-size:17px;font-weight:600;opacity:.8;margin-left:6px}
  #gear{font-size:20px;opacity:.9;margin-top:4px;color:#facc15}
  #bar{width:200px;height:8px;background:rgba(255,255,255,.2);border-radius:4px;margin-top:8px;margin-left:auto;overflow:hidden}
  #bar i{display:block;height:100%;width:0;background:linear-gradient(90deg,#4ade80,#facc15,#ef4444)}
  #start,#end{position:fixed;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:10;text-align:center;padding:20px}
  #start{background:radial-gradient(circle at 50% 40%,#1e3a5f,#05080f)}
  #end{background:rgba(0,0,0,.65);display:none}
  h1{font-size:52px;margin:0;font-style:italic;letter-spacing:2px;background:linear-gradient(90deg,#38bdf8,#f472b6);-webkit-background-clip:text;color:transparent}
  #end h2{font-size:56px;margin:0;font-style:italic}
  p{opacity:.85;max-width:440px;line-height:1.6}
  .big{margin-top:16px;font-size:22px;padding:14px 42px;border:0;border-radius:40px;background:linear-gradient(90deg,#38bdf8,#6366f1);color:#fff;font-weight:700;cursor:pointer}
  .tc{position:fixed;bottom:22px;width:80px;height:80px;border-radius:50%;background:rgba(255,255,255,.15);border:2px solid rgba(255,255,255,.35);display:none;align-items:center;justify-content:center;font-size:26px;z-index:5;touch-action:none;font-weight:700}
  @media (pointer:coarse){.tc{display:flex}#speedo{bottom:120px}}
</style>
</head>
<body>
<div id="start">
  <h1>TURBO DRIFT WORLD</h1>
  <p>Pahar-er tunnel, nodi-r upor bridge, ar city-r moddhe diye 3 lap race. 3 ta AI car-er age finish korte hobe!<br><br>
  W / ↑ = Gas &nbsp; S / ↓ = Brake / Reverse<br>A D / ← → = Steer &nbsp; SPACE = Handbrake (drift)<br>R = Respawn &nbsp; C = Camera</p>
  <button class="big" id="go">START RACE</button>
</div>
<div id="end"><h2 id="endT"></h2><p id="endS"></p><button class="big" id="again">RACE AGAIN</button></div>

<div id="hud">
  <div id="lap" class="panel">LAP <b id="lapn">1</b> / 3<br>Time <span id="time">0:00.00</span><br>Best <span id="best">--</span><br>Drift <span id="drift">0</span></div>
  <div id="pos" class="panel">POSITION<br><b id="posn">1</b> / 4<br><span id="gap"></span></div>
  <canvas id="mini" width="300" height="300"></canvas>
  <div id="btns"><button id="camBtn">📷</button><button id="rstBtn">⟲</button></div>
  <div id="zone" class="panel"></div>
  <div id="msg"></div>
  <div id="speedo"><div id="speed">0<small>km/h</small></div><div id="gear">N</div><div id="bar"><i id="rpm"></i></div></div>
</div>
<div class="tc" id="tl" style="left:14px">◀</div>
<div class="tc" id="tr" style="left:104px">▶</div>
<div class="tc" id="tb" style="right:104px;font-size:15px">BRK</div>
<div class="tc" id="tg" style="right:14px;font-size:15px">GAS</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
(() => {
'use strict';
const COARSE = matchMedia('(pointer:coarse)').matches;
const $ = id => document.getElementById(id);
const clamp = (v,a,b) => Math.min(b,Math.max(a,v));
const smooth = t => { t = clamp(t,0,1); return t*t*(3-2*t); };
function hash3(x,y,z){ const s = Math.sin(x*12.9898 + y*78.233 + z*37.719)*43758.5453; return s - Math.floor(s); }
let seed = 12345; const rnd = () => { seed = (seed*1664525 + 1013904223) % 4294967296; return seed/4294967296; };

// ================= Renderer / Scene =================
const renderer = new THREE.WebGLRenderer({antialias:true, powerPreference:'high-performance'});
renderer.setPixelRatio(Math.min(devicePixelRatio, COARSE ? 1.5 : 2));
renderer.setSize(innerWidth, innerHeight);
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
renderer.toneMapping = THREE.ACESFilmicToneMapping;
renderer.outputEncoding = THREE.sRGBEncoding;
document.body.appendChild(renderer.domElement);

const scene = new THREE.Scene();
scene.background = new THREE.Color(0x8ec5ff);
scene.fog = new THREE.Fog(0xbfdcff, 90, 560);
const camera = new THREE.PerspectiveCamera(65, innerWidth/innerHeight, 0.3, 1800);

(function makeEnv(){
  const envScene = new THREE.Scene();
  const mat = new THREE.ShaderMaterial({
    side: THREE.BackSide,
    vertexShader:`varying vec3 p;void main(){p=position;gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.);}`,
    fragmentShader:`varying vec3 p;void main(){float h=normalize(p).y;
      vec3 top=vec3(.25,.5,1.2);vec3 hor=vec3(1.,.95,.85);vec3 gnd=vec3(.18,.2,.18);
      vec3 c=h>0.?mix(hor,top,pow(h,.5)):mix(hor,gnd,pow(-h,.4));
      float sun=pow(max(dot(normalize(p),normalize(vec3(.5,.6,.4))),0.),64.);
      gl_FragColor=vec4(c+sun*6.,1.);}`
  });
  envScene.add(new THREE.Mesh(new THREE.SphereGeometry(100,32,16), mat));
  scene.environment = new THREE.PMREMGenerator(renderer).fromScene(envScene).texture;
})();

const hemi = new THREE.HemisphereLight(0xbfdcff, 0x3b5d2a, 0.55);
scene.add(hemi);
const sun = new THREE.DirectionalLight(0xfff2dd, 2.2);
sun.castShadow = true;
const SM = COARSE ? 1024 : 2048;
sun.shadow.mapSize.set(SM, SM);
const sc = sun.shadow.camera; sc.left=-70; sc.right=70; sc.top=70; sc.bottom=-70; sc.near=1; sc.far=400;
sun.shadow.bias = -0.0005;
scene.add(sun, sun.target);
const SUN_DIR = new THREE.Vector3(0.5,0.6,0.4).normalize();

// ================= Texture helpers =================
function canvasTex(w,h,draw,rx=1,ry=1){
  const c = document.createElement('canvas'); c.width=w; c.height=h;
  draw(c.getContext('2d'),w,h);
  const t = new THREE.CanvasTexture(c);
  t.wrapS = t.wrapT = THREE.RepeatWrapping; t.repeat.set(rx,ry);
  t.encoding = THREE.sRGBEncoding; t.anisotropy = 8;
  return t;
}
function noise(g,w,h,n,a){ for(let i=0;i<n;i++){const v=Math.random()*255|0;g.fillStyle=`rgba(${v},${v},${v},${Math.random()*a})`;g.fillRect(Math.random()*w,Math.random()*h,2,2);} }

// ================= Ground =================
const ground = new THREE.Mesh(
  new THREE.PlaneGeometry(4000,4000),
  new THREE.MeshStandardMaterial({map:canvasTex(256,256,(g,w,h)=>{g.fillStyle='#3f7d2f';g.fillRect(0,0,w,h);noise(g,w,h,12000,.1);},330,330), roughness:1})
);
ground.rotation.x = -Math.PI/2; ground.receiveShadow = true;
scene.add(ground);

// ================= Track =================
const ROAD_W = 16;
const RAIL_OFF = ROAD_W/2 + 2.4;
const ctrl = [];
for(let i=0;i<14;i++){
  const a = i/14*Math.PI*2;
  const r = 170*(1 + 0.45*Math.sin(a*3+0.7) + 0.2*Math.cos(a*2));
  ctrl.push(new THREE.Vector3(Math.cos(a)*r*1.35, 0, Math.sin(a)*r));
}
const curve = new THREE.CatmullRomCurve3(ctrl, true, 'catmullrom', 0.5);
const SEG = 900;
const pts = curve.getSpacedPoints(SEG); pts.pop();
const NP = pts.length;
const SP = curve.getLength()/NP;                     // metres per sample
const tans = pts.map((p,i)=> pts[(i+1)%NP].clone().sub(pts[(i-1+NP)%NP]).normalize());
const norms = tans.map(t=> new THREE.Vector3(-t.z,0,t.x));
const cen = pts.reduce((a,p)=>a.add(p),new THREE.Vector3()).multiplyScalar(1/NP);
const circ = (a,b) => { const d=Math.abs(a-b); return Math.min(d,NP-d); };

// ---- zones (fractions of the lap) ----
const MT0 = Math.floor(NP*0.06), MT1 = Math.floor(NP*0.31);   // mountains
const T0  = Math.floor(NP*0.12), T1  = Math.floor(NP*0.245);  // tunnel
const RB  = Math.floor(NP*0.47);                               // river / bridge centre
const C0  = Math.floor(NP*0.62), C1  = Math.floor(NP*0.90);    // city

// ---- height profile (bridge ramps) ----
const BF = Math.ceil(30/SP), BR = Math.ceil(95/SP), BH = 7;
const ys = new Float32Array(NP);
for(let i=0;i<NP;i++){
  const d = circ(i,RB);
  ys[i] = d<=BF ? BH : d<BF+BR ? BH*(1-smooth((d-BF)/BR)) : 0;
}
const slopeAt = i => (ys[(i+1)%NP]-ys[(i-1+NP)%NP])/(2*SP);

function nearestInfo(x,z){
  let best=1e12,bi=0;
  for(let i=0;i<NP;i+=2){const dx=pts[i].x-x,dz=pts[i].z-z,d=dx*dx+dz*dz;if(d<best){best=d;bi=i;}}
  return {d:Math.sqrt(best),i:bi};
}
function distToTrackEx(x,z,ex){
  let best=1e12;
  for(let i=0;i<NP;i+=3){ if(ex&&circ(i,RB)<ex)continue; const dx=pts[i].x-x,dz=pts[i].z-z,d=dx*dx+dz*dz;if(d<best)best=d; }
  return Math.sqrt(best);
}

function buildRibbon(w,y,mat,vRepeat,offset=0,i0=0,i1=NP,useH=true){
  const pos=[],uv=[],idx=[];
  for(let i=i0;i<=i1;i++){
    const k=i%NP,p=pts[k],n=norms[k],h=useH?ys[k]:0;
    const a=offset+w/2,b=offset-w/2;
    pos.push(p.x+n.x*a,y+h,p.z+n.z*a, p.x+n.x*b,y+h,p.z+n.z*b);
    const v=i/NP*vRepeat; uv.push(0,v,1,v);
    if(i<i1){const q=(i-i0)*2;idx.push(q,q+2,q+1, q+1,q+2,q+3);}
  }
  const g=new THREE.BufferGeometry();
  g.setAttribute('position',new THREE.Float32BufferAttribute(pos,3));
  g.setAttribute('uv',new THREE.Float32BufferAttribute(uv,2));
  g.setIndex(idx); g.computeVertexNormals();
  const m=new THREE.Mesh(g,mat); m.receiveShadow=true; return m;
}

// road
const roadTex = canvasTex(256,512,(g,w,h)=>{
  g.fillStyle='#2b2d31';g.fillRect(0,0,w,h);noise(g,w,h,30000,.35);
  g.fillStyle='#fff';g.fillRect(10,0,6,h);g.fillRect(w-16,0,6,h);
  g.fillStyle='#f5c518';g.fillRect(w/2-3,0,6,h*0.5);
});
scene.add(buildRibbon(ROAD_W,0.03,new THREE.MeshStandardMaterial({map:roadTex,roughness:.85}),90));

// curbs
const curbTex = canvasTex(16,64,(g)=>{g.fillStyle='#e11d1d';g.fillRect(0,0,16,32);g.fillStyle='#f4f4f4';g.fillRect(0,32,16,32);});
const curbMat = new THREE.MeshStandardMaterial({map:curbTex,roughness:.7});
scene.add(buildRibbon(1.2,0.05,curbMat,700,ROAD_W/2+0.6));
scene.add(buildRibbon(1.2,0.05,curbMat,700,-ROAD_W/2-0.6));

// guardrails
(function(){
  const railMat = new THREE.MeshStandardMaterial({color:0xb8c0c8,metalness:.8,roughness:.35,side:THREE.DoubleSide});
  const posts = new THREE.InstancedMesh(new THREE.BoxGeometry(.15,1.1,.15),new THREE.MeshStandardMaterial({color:0x444a52}),Math.ceil(NP/5)*2+4);
  let rp=0; const d=new THREE.Object3D();
  for(const s of [-1,1]){
    const pos=[],idx=[];
    for(let i=0;i<=NP;i++){
      const k=i%NP,p=pts[k],n=norms[k];
      const x=p.x+n.x*s*RAIL_OFF,z=p.z+n.z*s*RAIL_OFF;
      pos.push(x,ys[k]+0.55,z, x,ys[k]+1.0,z);
      if(i<NP){const q=i*2;idx.push(q,q+1,q+2,q+1,q+3,q+2);}
      if(i<NP&&i%5===0){d.position.set(x,ys[k]+.55,z);d.updateMatrix();posts.setMatrixAt(rp++,d.matrix);}
    }
    const g=new THREE.BufferGeometry();
    g.setAttribute('position',new THREE.Float32BufferAttribute(pos,3));g.setIndex(idx);g.computeVertexNormals();
    const m=new THREE.Mesh(g,railMat);m.castShadow=true;scene.add(m);
  }
  posts.count=rp;posts.castShadow=true;scene.add(posts);
})();

// start / finish line + gantry
(function(){
  const t=canvasTex(128,32,(g)=>{for(let y=0;y<4;y++)for(let x=0;x<16;x++){g.fillStyle=(x+y)%2?'#111':'#fff';g.fillRect(x*8,y*8,8,8);}});
  const geo=new THREE.PlaneGeometry(ROAD_W,3);geo.rotateX(-Math.PI/2);
  const m=new THREE.Mesh(geo,new THREE.MeshBasicMaterial({map:t}));
  const p=pts[0],tg=tans[0],n=norms[0],ang=Math.atan2(tg.x,tg.z);
  m.position.set(p.x,0.07,p.z);m.rotation.y=ang;scene.add(m);
  const mat=new THREE.MeshStandardMaterial({color:0x222831,metalness:.6,roughness:.4});
  for(const s of [-1,1]){
    const pole=new THREE.Mesh(new THREE.BoxGeometry(.7,9,.7),mat);
    pole.position.set(p.x+n.x*s*(RAIL_OFF+1.5),4.5,p.z+n.z*s*(RAIL_OFF+1.5));pole.castShadow=true;scene.add(pole);
  }
  const beam=new THREE.Mesh(new THREE.BoxGeometry(RAIL_OFF*2+4,1.6,.8),new THREE.MeshStandardMaterial({color:0xe11d48,emissive:0x550010,roughness:.4}));
  beam.position.set(p.x,9,p.z);beam.rotation.y=ang+Math.PI/2*0;
  beam.rotation.y=ang;beam.castShadow=true;scene.add(beam);
})();

// ================= River + Bridge =================
const RP = pts[RB];
const rn = norms[RB].clone(); if(rn.dot(cen.clone().sub(RP))<0) rn.negate();   // points to loop interior
const RIVER_W = 46;
let in1 = 50;  for(let d=40;d<420;d+=10){ const q=RP.clone().addScaledVector(rn,d);  if(distToTrackEx(q.x,q.z,120)<46)break; in1=d; }
let out1 = 120; for(let d=60;d<1300;d+=10){ const q=RP.clone().addScaledVector(rn,-d); if(d>80&&distToTrackEx(q.x,q.z,120)<46){out1=d;break;} out1=d; }
function nearRiver(x,z,m=0){
  const dx=x-RP.x,dz=z-RP.z,t=dx*rn.x+dz*rn.z,lat=Math.abs(-dx*rn.z+dz*rn.x);
  return (t>-out1-20&&t<in1+60&&lat<RIVER_W/2+m)||Math.hypot(dx-rn.x*in1,dz-rn.z*in1)<62+m;
}
const waterTex = canvasTex(256,256,(g,w,h)=>{
  const gr=g.createLinearGradient(0,0,0,h);gr.addColorStop(0,'#2b7bbd');gr.addColorStop(1,'#1f5f9a');g.fillStyle=gr;g.fillRect(0,0,w,h);
  g.strokeStyle='rgba(255,255,255,.22)';g.lineWidth=2;
  for(let i=0;i<40;i++){const x=Math.random()*w,y=Math.random()*h;g.beginPath();g.moveTo(x,y);g.quadraticCurveTo(x+14,y-5,x+30,y);g.stroke();}
},RIVER_W/28,(in1+out1)/28);
const waterMat = new THREE.MeshStandardMaterial({map:waterTex,roughness:.12,metalness:.2,transparent:true,opacity:.92});
const riverLen=in1+out1, mid=RP.clone().addScaledVector(rn,(in1-out1)/2);
const bankMat = new THREE.MeshStandardMaterial({color:0x6b5a3a,roughness:1});
{
  const bg=new THREE.PlaneGeometry(RIVER_W+9,riverLen);bg.rotateX(-Math.PI/2);
  const bank=new THREE.Mesh(bg,bankMat);bank.position.set(mid.x,0.04,mid.z);bank.rotation.y=Math.atan2(rn.x,rn.z);bank.receiveShadow=true;scene.add(bank);
  const wg=new THREE.PlaneGeometry(RIVER_W,riverLen);wg.rotateX(-Math.PI/2);
  const water=new THREE.Mesh(wg,waterMat);water.position.set(mid.x,0.09,mid.z);water.rotation.y=Math.atan2(rn.x,rn.z);scene.add(water);
  const lc=RP.clone().addScaledVector(rn,in1);
  const lb=new THREE.Mesh(new THREE.CircleGeometry(62,40).rotateX(-Math.PI/2),bankMat);lb.position.set(lc.x,0.04,lc.z);scene.add(lb);
  const lt=waterTex.clone();lt.repeat.set(3,3);lt.needsUpdate=true;
  const lake=new THREE.Mesh(new THREE.CircleGeometry(56,40).rotateX(-Math.PI/2),new THREE.MeshStandardMaterial({map:lt,roughness:.12,metalness:.2,transparent:true,opacity:.92}));
  lake.position.set(lc.x,0.09,lc.z);scene.add(lake);
}
// bridge deck, pillars, arches
(function(){
  const concrete = new THREE.MeshStandardMaterial({color:0x9a9a9a,roughness:.9});
  const r0=RB-BF-BR, r1=RB+BF+BR;
  const slabs = new THREE.InstancedMesh(new THREE.BoxGeometry(1,1,1),concrete,Math.ceil((r1-r0)/2)+4);
  const pil   = new THREE.InstancedMesh(new THREE.BoxGeometry(1,1,1),concrete,Math.ceil((r1-r0)/8)+4);
  let a=0,b=0; const d=new THREE.Object3D(); d.rotation.order='YXZ';
  for(let i=r0;i<=r1;i+=2){
    const k=((i%NP)+NP)%NP; if(ys[k]<0.25)continue;
    const p=pts[k],ang=Math.atan2(tans[k].x,tans[k].z);
    d.position.set(p.x,ys[k]-0.45,p.z);d.rotation.set(-Math.atan(slopeAt(k)),ang,0);d.scale.set(ROAD_W+1.8,0.9,SP*2+0.5);d.updateMatrix();slabs.setMatrixAt(a++,d.matrix);
    if(i%8===0&&ys[k]>1){
      d.position.set(p.x,(ys[k]-0.9)/2,p.z);d.rotation.set(0,ang,0);d.scale.set(ROAD_W*0.55,ys[k]-0.9,1.8);d.updateMatrix();pil.setMatrixAt(b++,d.matrix);
    }
  }
  slabs.count=a;pil.count=b;slabs.castShadow=slabs.receiveShadow=true;pil.castShadow=true;scene.add(slabs,pil);
  const steel=new THREE.MeshStandardMaterial({color:0xe2562a,metalness:.5,roughness:.4});
  const ag=new THREE.TorusGeometry(ROAD_W/2+2.4,0.35,8,24,Math.PI);
  for(let i=RB-BF;i<=RB+BF;i+=7){
    const k=((i%NP)+NP)%NP,p=pts[k];
    const m=new THREE.Mesh(ag,steel);m.scale.y=0.62;m.position.set(p.x,ys[k],p.z);m.rotation.y=Math.atan2(tans[k].x,tans[k].z);m.castShadow=true;scene.add(m);
  }
})();

// ================= Mountains + Tunnel =================
const rockMats=[0x7a736a,0x6b655e,0x857d72].map(c=>new THREE.MeshStandardMaterial({color:c,roughness:1,flatShading:true}));
function rockMound(x,y,z,rx,ry,rz,rotY,mat){
  const g=new THREE.IcosahedronGeometry(1,2),pa=g.attributes.position;
  for(let i=0;i<pa.count;i++){
    const px=pa.getX(i),py=pa.getY(i),pz=pa.getZ(i);
    const j=1+(hash3(Math.round(px*200),Math.round(py*200),Math.round(pz*200))-0.5)*0.24;
    pa.setXYZ(i,px*j,py*j,pz*j);
  }
  g.computeVertexNormals();
  const m=new THREE.Mesh(g,mat);m.position.set(x,y,z);m.scale.set(rx,ry,rz);m.rotation.y=rotY;m.castShadow=true;m.receiveShadow=true;scene.add(m);
}
(function(){
  for(let i=MT0;i<=MT1;i+=9){
    const k=i%NP,p=pts[k],n=norms[k],ang=Math.atan2(tans[k].x,tans[k].z);
    if(k>=T0-6&&k<=T1+6) rockMound(p.x,-4,p.z,26+rnd()*8,22+rnd()*10,20+rnd()*6,ang,rockMats[(rnd()*3)|0]);
    for(const s of [-1,1]){
      const r=16+rnd()*22,off=RAIL_OFF+r+4+rnd()*10,hg=r*(1.1+rnd()*1.2);
      rockMound(p.x+n.x*s*off,hg*0.3-2,p.z+n.z*s*off,r,hg,r*(0.9+rnd()*0.5),rnd()*6,rockMats[(rnd()*3)|0]);
    }
  }
  // tunnel lining
