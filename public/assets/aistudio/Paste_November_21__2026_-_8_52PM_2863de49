const MAX_SPEED=75,GEARS=[0,16,30,44,58,75];
function nearestIdx(x,z){
  let best=1e12,bi=state.idx;
  for(let o=-40;o<=40;o++){const i=(state.idx+o+NP)%NP,dx=pts[i].x-x,dz=pts[i].z-z,d=dx*dx+dz*dz;if(d<best){best=d;bi=i;}}
  if(best>60*60){best=1e12;for(let i=0;i<NP;i++){const dx=pts[i].x-x,dz=pts[i].z-z,d=dx*dx+dz*dz;if(d<best){best=d;bi=i;}}}
  return {i:bi,d:Math.sqrt(best)};
}
function playerStep(dt){
  const frozen=state.mode==='count';
  const up=!frozen&&(keys.ArrowUp||keys.KeyW),dn=!frozen&&(keys.ArrowDown||keys.KeyS);
  const lf=!frozen&&(keys.ArrowLeft||keys.KeyA),rt=!frozen&&(keys.ArrowRight||keys.KeyD),hb=!frozen&&keys.Space;
  let fx=Math.sin(state.h),fz=Math.cos(state.h),rx=Math.cos(state.h),rz=-Math.sin(state.h);
  let vf=state.vx*fx+state.vz*fz;

  const target=(lf?1:0)-(rt?1:0);
  const maxSteer=0.55/(1+Math.abs(vf)*0.045);
  state.steer+=(target*maxSteer-state.steer)*Math.min(1,dt*8);
  state.h+=state.steer*vf/2.8*dt*(hb?1.35:1);
  fx=Math.sin(state.h);fz=Math.cos(state.h);rx=Math.cos(state.h);rz=-Math.sin(state.h);
  vf=state.vx*fx+state.vz*fz;
  let vl=state.vx*rx+state.vz*rz;

  if(up)vf+=34*(1-Math.max(0,vf)/MAX_SPEED)*dt*(vf<0?2:1);
  if(dn){vf-=(vf>1?58:20)*dt;if(vf<-14)vf=-14;}
  if(!up&&!dn)vf-=vf*0.22*dt+Math.sign(vf)*1.5*dt;
  vf-=vf*Math.abs(vf)*0.0009*dt*8;
  if(hb)vf-=vf*0.9*dt;

  const n=nearestIdx(state.x,state.z);state.idx=n.i;
  state.onRoad=n.d<ROAD_W/2+1.6;
  if(!state.onRoad){vf-=vf*1.6*dt;state.shake=Math.min(1,Math.abs(vf)/30);}else state.shake*=0.9;

  if(Math.abs(vl)>3.5&&Math.abs(vf)>12&&state.onRoad&&state.mode==='race')state.drift+=(Math.abs(vl)-3)*Math.abs(vf)*dt*0.4;
  vl*=Math.exp(-(hb?1.6:(state.onRoad?9:4.5))*dt);

  state.vx=fx*vf+rx*vl;state.vz=fz*vf+rz*vl;
  state.x+=state.vx*dt;state.z+=state.vz*dt;

  // guardrail collision
  {
    const gp=pts[n.i],gn=norms[n.i];
    const lat=(state.x-gp.x)*gn.x+(state.z-gp.z)*gn.z,LIM=RAIL_OFF-1.2,a=Math.abs(lat);
    state.lat=lat;
    if(a>LIM){
      const s=Math.sign(lat);
      state.x-=gn.x*(a-LIM)*s;state.z-=gn.z*(a-LIM)*s;
      const vn=state.vx*gn.x+state.vz*gn.z;
      if(vn*s>0){state.vx-=gn.x*vn*1.5;state.vz-=gn.z*vn*1.5;state.vx*=.85;state.vz*=.85;state.shake=1;}
    }
  }

  // laps
  if(n.i>NP*0.45&&n.i<NP*0.6)state.half=true;
  if(state.mode==='race'&&state.half&&n.i<NP*0.1&&state.prevIdx>NP*0.9){
    const now=performance.now(),lt=(now-state.lapStart)/1000;
    state.half=false;state.lapsDone++;
    if(state.best===null||lt<state.best){state.best=lt;$('best').textContent=fmt(lt);}
    if(state.lapsDone>=TOTAL){endRace(true);}
    else{flash('LAP '+state.lapsDone+'  '+fmt(lt));state.lapStart=now;$('lapn').textContent=state.lapsDone+1;}
  }
  state.prevIdx=n.i;

  // HUD
  const ap=Math.abs(vf);
  $('speed').firstChild.nodeValue=Math.round(ap*3.6);
  let gNum=1;for(let i=1;i<GEARS.length;i++)if(ap>=GEARS[i-1])gNum=i;gNum=Math.min(gNum,5);
  const rpm=clamp((ap-GEARS[gNum-1])/(GEARS[gNum]-GEARS[gNum-1]),0,1)*0.75+(up?0.2:0.08);
  $('gear').textContent=vf<-0.5?'R':(ap<0.5?'N':gNum);
  $('rpm').style.width=(Math.min(rpm,1)*100)+'%';
  if(gain){
    const f=55+rpm*210+gNum*4;
    osc.frequency.setTargetAtTime(f,actx.currentTime,.04);osc2.frequency.setTargetAtTime(f*0.5,actx.currentTime,.04);
    filt.frequency.setTargetAtTime(500+rpm*1800,actx.currentTime,.05);
    gain.gain.setTargetAtTime(0.035+(up?0.03:0)+rpm*0.03,actx.currentTime,.05);
  }
  if(state.mode==='race')$('time').textContent=fmt((performance.now()-state.lapStart)/1000);
  $('drift').textContent=Math.floor(state.drift);

  // visuals
  state.y+=(ys[n.i]-state.y)*Math.min(1,dt*10);
  state.pitch+=(-Math.atan(slopeAt(n.i))-state.pitch)*Math.min(1,dt*8);
  player.car.position.set(state.x,state.y,state.z);
  player.car.rotation.set(state.pitch,state.h,0);
  player.body.rotation.z+=(clamp(-vl*0.012-state.steer*vf*0.003,-.12,.12)-player.body.rotation.z)*Math.min(1,dt*6);
  player.body.rotation.x+=((up?-0.015:dn&&vf>1?0.03:0)-player.body.rotation.x)*Math.min(1,dt*5);
  player.body.position.y=state.shake*Math.sin(performance.now()*0.05)*0.04;
  for(const w of player.wheels){w.spin.rotation.x+=vf/0.42*dt;if(w.front)w.pivot.rotation.y=state.steer*1.4;}
  player.tailM.emissiveIntensity=dn||hb?3.2:.7;
  if(frozen){state.vx=state.vz=0;}
}

// ================= AI =================
function updateAI(dt,t){
  const pp=playerProg();
  for(const a of ais){
    if(state.mode==='race'){
      const ia=Math.floor(a.prog)%NP,ib=(ia+Math.ceil(35/SP))%NP;
      const ang=Math.acos(clamp(tans[ia].dot(tans[ib]),-1,1));
      const vCorner=a.vmax*(1-Math.min(ang*0.75,0.55));
      const gap=(a.prog-pp)*SP;
      const rb=clamp(1-gap/600,0.9,1.08);
      a.hit=Math.max(0,a.hit-dt);
      const tv=vCorner*rb*(a.hit>0?0.8:1);
      a.v+=(tv-a.v)*Math.min(1,dt*0.6);
      a.prog+=a.v/SP*dt;
      // lane choice / avoid player
      const ahead=(pp-a.prog)*SP;
      if(ahead>1&&ahead<18&&Math.abs(state.lat-a.lane)<3.4){
        a.laneT=clamp(state.lat+(state.lat>a.lane?-4.2:4.2),-6.5,6.5);
      }else a.laneT=a.baseLane;
      a.lane+=(a.laneT-a.lane)*Math.min(1,dt*2);
      if(a.prog>=TOTAL*NP)endRace(false,a.name);
    }
    const i0=Math.floor(a.prog),f=a.prog-i0,k0=((i0%NP)+NP)%NP,k1=(k0+1)%NP;
    const p0=pts[k0],p1=pts[k1],n0=norms[k0],n1=norms[k1];
    const off=a.lane+Math.sin(t*0.6+a.ph)*0.8*(state.mode==='race'?1:0);
    const nx=n0.x+(n1.x-n0.x)*f,nz=n0.z+(n1.z-n0.z)*f;
    const px=p0.x+(p1.x-p0.x)*f+nx*off,pz=p0.z+(p1.z-p0.z)*f+nz*off;
    const tx=tans[k0].x+(tans[k1].x-tans[k0].x)*f,tz=tans[k0].z+(tans[k1].z-tans[k0].z)*f;
    const y=ys[k0]+(ys[k1]-ys[k0])*f;
    a.car.position.set(px,y,pz);
    a.car.rotation.set(-Math.atan(slopeAt(k0)),Math.atan2(tx,tz),0);
    for(const w of a.wheels)w.spin.rotation.x+=a.v/0.42*dt;
    a.tailM.emissiveIntensity=.7;
    a.px=px;a.pz=pz;

    // collision with player
    const dx=state.x-px,dz=state.z-pz,d=Math.hypot(dx,dz);
    if(d<3.0&&d>0.001&&state.mode!=='count'){
      const nxn=dx/d,nzn=dz/d;
      state.x+=nxn*(3.0-d)*0.7;state.z+=nzn*(3.0-d)*0.7;
      const vn=state.vx*nxn+state.vz*nzn;
      if(vn<0){state.vx-=nxn*vn*1.4;state.vz-=nzn*vn*1.4;}
      state.vx*=0.94;state.vz*=0.94;state.shake=1;a.hit=0.6;
    }
  }
}

// ================= Minimap =================
const mini=$('mini'),mctx=mini.getContext('2d'),MS=300;
let minX=1e9,maxX=-1e9,minZ=1e9,maxZ=-1e9;
pts.forEach(p=>{minX=Math.min(minX,p.x);maxX=Math.max(maxX,p.x);minZ=Math.min(minZ,p.z);maxZ=Math.max(maxZ,p.z);});
const pad=34,msc=(MS-pad*2)/Math.max(maxX-minX,maxZ-minZ);
const mox=pad+((MS-pad*2)-(maxX-minX)*msc)/2,moz=pad+((MS-pad*2)-(maxZ-minZ)*msc)/2;
const mp=(x,z)=>[mox+(x-minX)*msc,moz+(z-minZ)*msc];
const mbg=document.createElement('canvas');mbg.width=mbg.height=MS;
(function(){
  const g=mbg.getContext('2d');
  g.fillStyle='rgba(15,25,40,.72)';g.beginPath();g.roundRect?g.roundRect(0,0,MS,MS,22):g.rect(0,0,MS,MS);g.fill();
  g.lineCap='round';g.lineJoin='round';
  // river
  const a=mp(RP.x+rn.x*in1,RP.z+rn.z*in1),b=mp(RP.x-rn.x*out1,RP.z-rn.z*out1);
  g.strokeStyle='#3b82f6';g.lineWidth=12;g.beginPath();g.moveTo(a[0],a[1]);g.lineTo(b[0],b[1]);g.stroke();
  const path=(i0,i1,col,w)=>{g.strokeStyle=col;g.lineWidth=w;g.beginPath();for(let i=i0;i<=i1;i++){const q=mp(pts[i%NP].x,pts[i%NP].z);i===i0?g.moveTo(q[0],q[1]):g.lineTo(q[0],q[1]);}g.stroke();};
  path(0,NP,'#d5dbe2',9);
  path(MT0,MT1,'#b08a62',9);path(T0,T1,'#3a3a3a',9);path(C0,C1,'#e8a54b',9);
  path(RB-BF-BR,RB+BF+BR,'#f5f5f5',9);
  g.font='28px sans-serif';g.textAlign='center';g.textBaseline='middle';
  const lab=(i,s)=>{const p=pts[i%NP],n=norms[i%NP],sd=(n.dot(cen.clone().sub(p))>0)?-1:1;const q=mp(p.x+n.x*sd*70,p.z+n.z*sd*70);g.fillText(s,q[0],q[1]);};
  lab((T0+T1)>>1,'⛰');lab(RB,'🌉');lab((C0+C1)>>1,'🏙');
  const s0=mp(pts[0].x,pts[0].z);g.fillStyle='#fff';g.fillRect(s0[0]-6,s0[1]-3,12,6);
})();
function drawMini(){
  mctx.clearRect(0,0,MS,MS);mctx.drawImage(mbg,0,0);
  for(const a of ais){const q=mp(a.px||0,a.pz||0);mctx.fillStyle='#'+a.color.toString(16).padStart(6,'0');mctx.beginPath();mctx.arc(q[0],q[1],8,0,7);mctx.fill();}
  const q=mp(state.x,state.z);
  mctx.fillStyle='#ef4444';mctx.strokeStyle='#fff';mctx.lineWidth=4;mctx.beginPath();mctx.arc(q[0],q[1],10,0,7);mctx.fill();mctx.stroke();
}

// ================= Camera =================
const camPos=new THREE.Vector3(),camLook=new THREE.Vector3();
function updateCamera(dt){
  const fx=Math.sin(state.h),fz=Math.cos(state.h),speed=Math.hypot(state.vx,state.vz);
  let dx=fx,dz=fz;
  if(speed>6){dx=fx*.7+state.vx/speed*.3;dz=fz*.7+state.vz/speed*.3;const l=Math.hypot(dx,dz);dx/=l;dz/=l;}
  let back,height,look;
  if(state.cam===0){back=8.5+speed*0.03;height=3.2;look=5;}
  else if(state.cam===1){back=-0.3;height=1.25;look=14;}
  else{back=14;height=5.6;look=4;}
  const target=new THREE.Vector3(state.x-dx*back,state.y+height,state.z-dz*back);
  if(!camInit){camPos.copy(target);camInit=true;}
  camPos.lerp(target,Math.min(1,dt*(state.cam===1?30:5)));
  camera.position.copy(camPos);
  camera.position.y+=state.shake*Math.sin(performance.now()*.06)*.05;
  camLook.set(state.x+fx*look,state.y+1.1,state.z+fz*look);camera.lookAt(camLook);
  const fov=62+Math.min(speed,70)*0.28;camera.fov+=(fov-camera.fov)*Math.min(1,dt*3);camera.updateProjectionMatrix();
  sun.position.set(state.x+SUN_DIR.x*120,SUN_DIR.y*120,state.z+SUN_DIR.z*120);sun.target.position.set(state.x,0,state.z);
}

// ================= Loop =================
let last=performance.now();
function loop(now){
  requestAnimationFrame(loop);
  const dt=Math.min(0.033,(now-last)/1000),t=now/1000;last=now;

  if(state.started){
    if(state.mode==='count'){
      state.countT-=dt;
      const c=Math.ceil(state.countT);
      if(c!==state.lastCount){state.lastCount=c;if(c>0)flash(String(c),0);}
      if(state.countT<=0){state.mode='race';state.lapStart=state.raceStart=performance.now();flash('GO!',900);}
    }
    playerStep(dt);
  }else{
    player.car.position.set(state.x,0,state.z);player.car.rotation.set(0,state.h,0);
  }
  updateAI(dt,t);

  // position HUD
  const pp=playerProg();let pos=1;for(const a of ais)if(a.prog>pp)pos++;
  $('posn').textContent=pos;
  const lead=ais.reduce((m,a)=>a.prog>m.prog?a:m,ais[0]);
  const g2=Math.round((lead.prog-pp)*SP);
  $('gap').innerHTML=pos===1?'':('<span>'+lead.name+' +'+Math.max(0,g2)+' m</span>');
  if(state.started&&state.mode==='race'){$('lapn').textContent=Math.min(state.lapsDone+1,TOTAL);setZone(zoneOf(state.idx));}

  // tunnel lighting
  const inT=state.idx>=T0&&state.idx<=T1?1:0;
  state.tf+=(inT-state.tf)*Math.min(1,dt*4);
  hemi.intensity=0.55-0.4*state.tf;sun.intensity=2.2-1.9*state.tf;tunnelLight.intensity=2.4*state.tf;renderer.toneMappingExposure=1-0.1*state.tf;

  waterTex.offset.y-=dt*0.05;
  updateCamera(dt);
  drawMini();
  renderer.render(scene,camera);
}
addEventListener('resize',()=>{renderer.setSize(innerWidth,innerHeight);camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();});
$('go').addEventListener('click',()=>{$('start').style.display='none';startAudio();state.started=true;resetRace();});
$('again').addEventListener('click',()=>{resetRace();});
requestAnimationFrame(loop);
})();
</script>
